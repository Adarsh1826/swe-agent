generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
// user table
model User {
  id       Int    @id @default(autoincrement())
  githubId      Int  @unique
  username      String 
  avatarUrl     String?  
  profileUrl    String?

  apis     Apis[]   
  job  Job[]
 
}

// api table
model Apis {
  id           Int    @id @default(autoincrement())
  providerName String
  apiKey       String
  iv           String
  userId       Int?
  user         User?  @relation(fields: [userId], references: [id])

  guestId      String?

  @@index([guestId])
}
// repo table 
model Job{
  id Int @id @default(autoincrement())
  repoUrl  String
  userId Int? 
  status StatusEnum @default(PENDING)
  issueNumber Int
  
  issueTitle     String     
  issueBody      String     
  installationId Int        

  user User? @relation(fields: [userId],references: [id])
  guestId String?
  @@index([guestId])
  @@unique([repoUrl, issueNumber])

}
// ek active api key hoga 
enum StatusEnum {
  PENDING
  COMPLETED
  FAILED
}